{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset *)",
      "Bash(cmake --build *)",
      "Bash(ctest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run pytest*)",
      "Bash(uv run --no-project scripts/codemap.py*)",
      "Bash(shellcheck *)",
      "Bash(shfmt -d *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git remote*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(gh *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
